android_app {
    name: "LineageSlider",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    static_libs: [
        "vendor.lineage.slider-V1-java",
        "org.lineageos.platform.internal",
        "org.lineageos.settings.resources",
    ],
}
